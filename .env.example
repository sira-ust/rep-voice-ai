# Copy to .env and fill in. .env is git-ignored and must stay that way --
# every value below marked "secret" is a live credential.

# ============================================================
#  APP AUTHENTICATION
# ============================================================
# The endpoints this server exposes can start billable ElevenLabs
# conversations, so the page and every /api/* route require a session.
#
# APP_USERS is "name:hash,name:hash". With it empty there are no accounts and
# every sign-in fails, which is the intended default -- a built-in account
# would ship its hash in the repository.
#   python auth.py --add-user rep    -> APP_USERS=...
#
# APP_SECRET signs session cookies; without it sessions die on each restart.
#   python auth.py --secret          -> APP_SECRET=...
# Rotating APP_SECRET signs everyone out immediately.

APP_SECRET=
APP_USERS=

# How long a sign-in lasts.
APP_SESSION_HOURS=12

# Conversations one user may start per hour. Each one costs credits.
APP_TOKENS_PER_HOUR=30

# Failed sign-ins allowed per source address per 15 minutes.
APP_LOGIN_ATTEMPTS=10

# Content-Security-Policy. Leave on; set to off only to diagnose a
# CSP-related breakage, and verify in a browser before deciding it is the CSP.
APP_CSP=on

# Set to 1 only when running behind a reverse proxy that sets
# X-Forwarded-For. Trusting it otherwise lets a caller forge their source
# address and bypass the sign-in rate limit.
APP_TRUST_PROXY=

# Session cookies are Secure, so browsers withhold them over plain HTTP. The
# server relaxes this by itself when bound to loopback, so local development
# needs nothing here. Set to 1 only to force it off elsewhere, and 0 to force
# it on for a loopback bind.
APP_INSECURE_COOKIE=

# ============================================================
#  ELEVENLABS
# ============================================================
# Key   : https://elevenlabs.io/app/settings/api-keys          (secret)
# Agent : https://elevenlabs.io/app/agents  -> agent_xxxxxxxx
# Read only by server.py and the configure_* scripts. Never sent to a browser;
# the page receives a short-lived signed URL instead.

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Where the local web server listens.
HOST=127.0.0.1
PORT=8080

# ============================================================
#  CUSTOM LLM (any OpenAI-compatible server, e.g. vLLM)
# ============================================================
# ElevenLabs' servers call this URL directly, so it must be reachable from the
# public internet, serve {URL}/chat/completions, and stream Server-Sent Events.
# A localhost URL cannot work. Include the /v1.
#
# vLLM must be started with tool calling enabled or every call fails:
#   vllm serve <model> --enable-auto-tool-choice --tool-call-parser <parser>

CUSTOM_LLM_URL=https://your-llm-host.example.com/v1
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# Name of the ElevenLabs workspace secret that stores the key above.
CUSTOM_LLM_SECRET_NAME=CUSTOM_LLM_API_KEY

# A WAF or CDN in front of the LLM host may block non-browser User-Agents,
# which surfaces only as a generic "custom_llm generation failed". Sent as a
# request header on every call. Leave blank to omit it.
CUSTOM_LLM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ============================================================
#  DATABRICKS
# ============================================================
# Connection settings only. Which tables the agent may read, and how, lives in
# databricks_tools.json -- edit that and run `databricks_tool.py --sync`.
#
#   HOST         workspace URL, no trailing slash
#                https://dbc-xxxx.cloud.databricks.com  (AWS)
#                https://adb-xxxx.N.azuredatabricks.net (Azure)
#   TOKEN        personal access token or service principal token   (secret)
#   WAREHOUSE_ID last segment of the SQL warehouse HTTP path,
#                /sql/1.0/warehouses/<THIS>. Use a serverless warehouse; a
#                classic one cold-starts for minutes and the call times out.

DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# Name of the ElevenLabs workspace secret holding "Bearer <token>".
DATABRICKS_SECRET_NAME=DATABRICKS_BEARER

# --- warehouse pre-warm (optional) ---
# A cold serverless warehouse takes 10-15s on its first query, long enough to
# blow the tool timeout and tell the caller "I encountered an error". With a
# token here, the server submits SELECT 1 when someone signs in and when a
# conversation starts, so the warehouse boots while the agent is greeting them.
#
# SELECT 1 reads no table, so this credential needs only CAN_USE on the
# warehouse and NO catalog grants. Use a service principal with nothing else
# granted -- then the worst it can do is start a warehouse. Falls back to
# DATABRICKS_TOKEN if unset, which is convenient but puts a data-capable token
# on the web host. Leave both unset to disable pre-warming.
DATABRICKS_WARM_TOKEN=

# Never warm more often than this, however many sessions start.
DATABRICKS_WARM_MINUTES=10

# Per-tool ceiling in seconds. A cold serverless warehouse has taken 10-15s;
# at the 10s default that reached the caller as "I encountered an error".
DATABRICKS_TOOL_TIMEOUT=30
